generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Permission {
  id          String  @id
  name        String
  label       String
  module      String
  description String?
}

model Role {
  id            String   @id
  name          String
  label         String
  description   String?
  isSystem      Boolean  @default(false)
  permissionIds String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  phone        String?
  status       UserStatus @default(ACTIVE)
  roleId       String
  terminalId   String?
  avatarColor  String?    @default("#3B82F6")
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  role         Role       @relation(fields: [roleId], references: [id])
  terminal     Terminal?  @relation(fields: [terminalId], references: [id])
}

model Terminal {
  id                String             @id @default(uuid())
  name              String
  code              String             @unique
  address           String
  latitude          Float
  longitude         Float
  capacity          Int
  status            TerminalStatus     @default(OPERATIONAL)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  devices           Device[]
  queueEntries      QueueEntry[]
  destRoutes        Route[]            @relation("DestinationTerminal")
  originRoutes      Route[]            @relation("OriginTerminal")
  users             User[]
  assignmentsDest   WeeklyAssignment[] @relation("AssignmentDestination")
  assignmentsOrigin WeeklyAssignment[] @relation("AssignmentOrigin")
  cameraDevices     CameraDevice[]
  recognitionEvents RecognitionEvent[]
}

model Route {
  id                    String      @id @default(uuid())
  name                  String
  code                  String      @unique
  originTerminalId      String
  destinationTerminalId String
  distanceKm            Float
  estimatedMinutes      Int
  status                RouteStatus @default(ACTIVE)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  destinationTerminal   Terminal    @relation("DestinationTerminal", fields: [destinationTerminalId], references: [id])
  originTerminal        Terminal    @relation("OriginTerminal", fields: [originTerminalId], references: [id])
}

model VehicleGroup {
  id          String             @id
  name        String
  description String?
  vehicles    Vehicle[]
  assignments WeeklyAssignment[]
}

model Vehicle {
  id                String             @id @default(uuid())
  plateNumber       String             @unique
  model             String
  type              VehicleType
  capacity          Int
  status            VehicleStatus      @default(IDLE)
  journeyState      JourneyState       @default(WAITING)
  groupId           String
  driverName        String?
  driverPhone       String?
  lastMaintenance   DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  queueEntries      QueueEntry[]
  group             VehicleGroup       @relation(fields: [groupId], references: [id])
  recognitionEvents RecognitionEvent[]
  account           VehicleAccount?
  cards             TransportCard[]
  transactions      VehicleAccountTransaction[]
  violations        Violation[]
}

model WeeklyAssignment {
  id                    String           @id @default(uuid())
  name                  String
  weekNumber            Int
  weekStart             DateTime
  weekEnd               DateTime
  vehicleGroupId        String
  originTerminalId      String
  destinationTerminalId String
  dispatcherIds         String[]
  status                AssignmentStatus @default(DRAFT)
  reviewedAt            DateTime?
  reviewedBy            String?
  lockedAt              DateTime?
  lockedBy              String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  queueEntries          QueueEntry[]
  destinationTerminal   Terminal         @relation("AssignmentDestination", fields: [destinationTerminalId], references: [id])
  originTerminal        Terminal         @relation("AssignmentOrigin", fields: [originTerminalId], references: [id])
  vehicleGroup          VehicleGroup     @relation(fields: [vehicleGroupId], references: [id])
}

model QueueEntry {
  id                      String           @id @default(uuid())
  vehicleId               String
  plateNumber             String
  vehicleGroupName        String
  assignmentId            String
  terminalId              String
  terminalName            String
  destinationTerminalName String
  position                Int
  status                  QueueStatus      @default(WAITING)
  entryType               QueueEntryType   @default(MANUAL)
  recognitionEventId      String?
  cameraId                String?
  exitCameraId            String?
  confidence              Float?
  checkedInAt             DateTime         @default(now())
  checkedInBy             String
  dispatchInTime          DateTime?
  exitCapturedAt          DateTime?
  dispatchedAt            DateTime?
  dispatchedBy            String?
  isViolation             Boolean          @default(false)
  violationRemark         String?
  assignment              WeeklyAssignment @relation(fields: [assignmentId], references: [id])
  terminal                Terminal         @relation(fields: [terminalId], references: [id])
  vehicle                 Vehicle          @relation(fields: [vehicleId], references: [id])
}

model DispatchRecord {
  id                      String        @id @default(uuid())
  vehicleId               String
  plateNumber             String
  vehicleGroupId          String
  vehicleGroupName        String
  originTerminalId        String
  originTerminalName      String
  destinationTerminalId   String
  destinationTerminalName String
  dispatcherId            String
  dispatcherName          String
  dispatchTime            DateTime      @default(now())
  entryTime               DateTime?
  dispatchInTime          DateTime?
  dispatchOutTime         DateTime?
  queuePosition           Int
  feeAmount               Float
  feeRuleId               String
  paymentStatus           PaymentStatus @default(PENDING)
  paymentReference        String?
  paymentCollectorId      String?
  paymentCollectorName    String?
  paymentConfirmedAt      DateTime?
  tripStatus              String        @default("COMPLETED")
  deviceId                String?
  auditRef                String
  entryRecognitionEventId String?
  exitRecognitionEventId  String?
  departureConfirmed      Boolean       @default(false)
}

model DispatchFeeRule {
  id          String      @id @default(uuid())
  name        String
  amount      Float
  currency    String      @default("ETB")
  vehicleType VehicleType
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model VehicleAccount {
  id                String                 @id @default(uuid())
  vehicleId         String                 @unique
  plateNumber       String
  balance           Float                  @default(0.0)
  status            VehicleAccountStatus   @default(ACTIVE)
  lastTransactionAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  vehicle           Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  transactions      VehicleAccountTransaction[]
}

model TransportCard {
  id            String               @id @default(uuid())
  cardUid       String               @unique
  cardNumber    String               @unique
  vehicleId     String
  status        TransportCardStatus  @default(ACTIVE)
  issuedAt      DateTime             @default(now())
  expiresAt     DateTime?
  blockedAt     DateTime?
  blockedReason String?
  createdBy     String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  vehicle       Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  transactions  VehicleAccountTransaction[]
}

model VehicleAccountTransaction {
  id                 String                 @id @default(uuid())
  vehicleAccountId   String
  vehicleId          String
  cardId             String?
  type               VehicleTransactionType
  amount             Float
  balanceBefore      Float
  balanceAfter       Float
  paymentMethod      PaymentMethod?
  paymentReference   String?
  dispatchRecordId   String?
  violationId        String?
  description        String
  performedBy        String
  createdAt          DateTime               @default(now())
  vehicleAccount     VehicleAccount         @relation(fields: [vehicleAccountId], references: [id], onDelete: Cascade)
  vehicle            Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  card               TransportCard?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
}

model PenaltyConfiguration {
  id            String           @id @default("default-penalty-config")
  name          String           @default("Default Unauthorized Departure Penalty")
  ruleType      PenaltyRuleType  @default(FIXED_AMOUNT)
  amount        Float            @default(50.0)
  description   String?          @default("Standard penalty for unauthorized departure or dispatch without payment")
  active        Boolean          @default(true)
  updatedBy     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Violation {
  id                      String            @id @default(uuid())
  vehicleId               String
  plateNumber             String
  assignmentId            String?
  routeId                 String?
  terminalId              String?
  assignedTerminalId      String?
  assignedRouteId         String?
  entryRecognitionEventId String?
  imagePath               String?
  type                    String
  description             String
  severity                ViolationSeverity @default(MEDIUM)
  status                  ViolationStatus   @default(OPEN)
  reportedBy              String
  reportedAt              DateTime          @default(now())
  resolvedAt              DateTime?
  resolution              String?
  resolutionAction        String?
  dispatcherId            String?
  remark                  String?
  queueEntryId            String?
  originalDispatchFee     Float?            @default(0.0)
  penaltyAmount           Float?            @default(0.0)
  totalAmountDue          Float?            @default(0.0)
  evidence                String?
  vehicle                 Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Override {
  id           String         @id @default(uuid())
  requestedBy  String
  action       String
  reason       String
  assignmentId String?
  status       OverrideStatus @default(PENDING)
  approvedBy   String?
  approvedAt   DateTime?
  auditRef     String?
  createdAt    DateTime       @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  entity    String
  entityId  String
  details   String
  ipAddress String?
  timestamp DateTime @default(now())
}

model Device {
  id         String       @id @default(uuid())
  name       String
  deviceId   String       @unique
  terminalId String?
  status     DeviceStatus @default(PENDING)
  lastSyncAt DateTime?
  appVersion String?
  terminal   Terminal?    @relation(fields: [terminalId], references: [id])
}

model CameraDevice {
  id                 String             @id @default(uuid())
  name               String
  code               String             @unique
  terminalId         String
  gateName           String
  cameraType         CameraType         @default(ENTRY)
  sourceType         CameraSourceType   @default(RTSP)
  sourceAddress      String
  status             CameraStatus       @default(ACTIVE)
  lastHeartbeat      DateTime?
  recognitionEnabled Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  terminal           Terminal           @relation(fields: [terminalId], references: [id])
  events             RecognitionEvent[]
  heartbeats         CameraHeartbeat[]
}

model RecognitionEvent {
  id               String                     @id @default(uuid())
  cameraId         String
  terminalId       String
  cameraType       CameraType                 @default(ENTRY)
  plateNumber      String
  rawPlateNumber   String?
  confidence       Float                      @default(0.0)
  capturedAt       DateTime                   @default(now())
  imagePath        String?
  processingResult RecognitionProcessingResult @default(ACCEPTED)
  vehicleId        String?
  queueEntryId     String?
  violationId      String?
  remarks          String?
  createdAt        DateTime                   @default(now())
  camera           CameraDevice               @relation(fields: [cameraId], references: [id])
  terminal         Terminal                   @relation(fields: [terminalId], references: [id])
  vehicle          Vehicle?                   @relation(fields: [vehicleId], references: [id])
}

model RecognitionConfiguration {
  id                      String   @id @default(uuid())
  terminalId              String   @unique
  minConfidenceThreshold Float    @default(0.70)
  autoQueueEnabled        Boolean  @default(true)
  violationOnUnassigned   Boolean  @default(true)
  duplicateWindowSeconds  Int      @default(300)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model CameraHeartbeat {
  id        String       @id @default(uuid())
  cameraId  String
  status    CameraStatus @default(ACTIVE)
  timestamp DateTime     @default(now())
  details   String?
  camera    CameraDevice @relation(fields: [cameraId], references: [id])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum TerminalStatus {
  OPERATIONAL
  DEGRADED
  OFFLINE
  MAINTENANCE
}

enum RouteStatus {
  ACTIVE
  INACTIVE
  PLANNED
}

enum VehicleStatus {
  IDLE
  WAITING
  DISPATCHED
  IN_TRANSIT
  MAINTENANCE
  OFFLINE
}

enum VehicleAccountStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  OUTSTANDING_DEBT
}

enum TransportCardStatus {
  ACTIVE
  BLOCKED
  LOST
  REPLACED
  EXPIRED
}

enum VehicleTransactionType {
  TOPUP
  DISPATCH_FEE
  PENALTY
  REFUND
  ADJUSTMENT
  CARD_REPLACEMENT_FEE
}

enum PaymentMethod {
  CASH
  TELEBIRR
  CBE_BIRR
  BANK_TRANSFER
  OTHER
}

enum PenaltyRuleType {
  FIXED_AMOUNT
  PERCENTAGE_OF_FEE
  FEE_MULTIPLIER
}

enum VehicleType {
  BUS
  MINIBUS
  COASTER
  TRUCK
}

enum AssignmentStatus {
  DRAFT
  REVIEWED
  PUBLISHED
  LOCKED
  ARCHIVED
}

enum QueueStatus {
  WAITING
  LOADING
  READY_TO_DEPART
  DETECTED_AT_EXIT
  DISPATCHED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  WAIVED
  CANCELLED
}

enum ViolationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ViolationStatus {
  OPEN
  IN_REVIEW
  UNDER_REVIEW
  PENALTY_APPLIED
  PAID
  WAIVED
  RESOLVED
  DISMISSED
}

enum OverrideStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DeviceStatus {
  APPROVED
  PENDING
  REJECTED
  OFFLINE
}

enum CameraType {
  ENTRY
  EXIT
  SURVEILLANCE
}

enum CameraSourceType {
  USB
  RTSP
  ONVIF
  VIDEO_FILE
  ANDROID_PHONE
  MOCK_SYNTHETIC
}

enum CameraStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  OFFLINE
}

enum JourneyState {
  WAITING
  DISPATCHED
  ON_ROUTE
  ARRIVED
  READY_FOR_RETURN
}

enum QueueEntryType {
  AUTO_RECOGNIZED
  MANUAL
  VIOLATION
}

enum RecognitionProcessingResult {
  ACCEPTED
  DUPLICATE
  UNKNOWN
  LOW_CONFIDENCE
  NOT_ASSIGNED
  UNAUTHORIZED_TERMINAL
  SUSPENDED
}


